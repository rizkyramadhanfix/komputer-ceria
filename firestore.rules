rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Connection test document
    match /_connection_test/{testId} {
      allow read, write: if true;
    }

    // Users collection: readable across devices so students/teachers can log in from any phone/laptop
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Lessons: readable by all devices, writable by admin/teachers
    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if true;
    }

    // Quizzes: readable by all devices, writable by admin/teachers
    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if true;
    }

    // Typing practices: readable by all devices, writable by admin/teachers
    match /typingPractices/{practiceId} {
      allow read: if true;
      allow write: if true;
    }

    // Student typing submissions: readable and submittable from any device
    match /typingSubmissions/{submissionId} {
      allow read: if true;
      allow write: if true;
    }

    // Student quiz submissions: readable and submittable from any device
    match /quizSubmissions/{submissionId} {
      allow read: if true;
      allow write: if true;
    }

    // Student gallery artwork and documents: public gallery readable and submittable
    match /galleryWorks/{workId} {
      allow read: if true;
      allow write: if true;
    }

    // Mini-game scores
    match /gameScores/{scoreId} {
      allow read: if true;
      allow write: if true;
    }

    // Audit login logs across devices
    match /loginLogs/{logId} {
      allow read: if true;
      allow write: if true;
    }

    // Typing tournaments
    match /typingTournaments/{tournamentId} {
      allow read: if true;
      allow write: if true;
    }

    // School rewards catalogue
    match /schoolRewards/{rewardId} {
      allow read: if true;
      allow write: if true;
    }

    // Student reward redemptions
    match /rewardRedemptions/{redemptionId} {
      allow read: if true;
      allow write: if true;
    }

    // School announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if true;
    }

    // Platform configs (gamification, certificate, dashboard, games)
    match /config/{configId} {
      allow read: if true;
      allow write: if true;
    }

    // Platform settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Multiplayer 1v1 Quiz Duels across devices
    match /duels/{duelId} {
      allow read: if true;
      allow write: if true;
    }

    // Fallback default deny for any unrecognized paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
